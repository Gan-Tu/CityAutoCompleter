{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "city-autocompleter",
  "compatibility_date": "2026-06-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "city-autocompleter.gan.dev",
      "custom_domain": true
    }
  ]
}
